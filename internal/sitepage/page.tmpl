</head>
<body class="relative min-h-full overflow-x-hidden bg-slate-950 font-sans text-slate-300 antialiased selection:bg-indigo-500/40 selection:text-white">

  <!-- backdrop: grid, glows -->
  <div aria-hidden="true" class="pointer-events-none fixed inset-0 bg-[linear-gradient(to_right,rgb(148_163_184/0.07)_1px,transparent_1px),linear-gradient(to_bottom,rgb(148_163_184/0.07)_1px,transparent_1px)] bg-[size:56px_56px] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,black,transparent)]"></div>
  <div aria-hidden="true" class="pointer-events-none fixed -top-40 left-1/2 h-[36rem] w-[36rem] -translate-x-1/2 rounded-full bg-indigo-600/30 blur-[120px] motion-safe:animate-[glow_9s_ease-in-out_infinite]"></div>
  <div aria-hidden="true" class="pointer-events-none fixed top-1/3 -right-32 h-80 w-80 rounded-full bg-fuchsia-500/20 blur-[110px] motion-safe:animate-[glow_11s_ease-in-out_infinite_reverse]"></div>
  <div aria-hidden="true" class="pointer-events-none fixed bottom-0 -left-32 h-80 w-80 rounded-full bg-cyan-400/15 blur-[110px] motion-safe:animate-[glow_13s_ease-in-out_infinite]"></div>

  <main class="relative mx-auto flex min-h-screen max-w-5xl flex-col px-5 py-10 sm:px-8 sm:py-14">

    <header class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-2.5">
        <span class="grid h-9 w-9 place-items-center rounded-xl bg-gradient-to-br from-indigo-500 to-violet-600 shadow-lg shadow-indigo-500/30 ring-1 ring-white/20">
          <svg viewBox="0 0 24 24" class="h-5 w-5 text-white" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h10M4 17h7"/></svg>
        </span>
        <span class="text-sm font-semibold tracking-tight text-white">SigardaPanel</span>
      </div>
      <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3 py-1 text-xs font-medium text-emerald-300">
        <span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75 motion-safe:animate-ping"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span></span>
        Online
      </span>
    </header>

    <section class="mt-16 text-center sm:mt-24">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 text-xs font-medium text-slate-300 backdrop-blur">
        <span class="h-1.5 w-1.5 rounded-full bg-gradient-to-r from-indigo-400 to-fuchsia-400"></span>
        {{.RuntimeLabel}} site
      </span>
      <h1 class="mx-auto mt-6 max-w-4xl bg-gradient-to-b from-white via-white to-slate-400 bg-clip-text font-bold tracking-tight break-words text-transparent text-[2rem] leading-tight sm:text-6xl">{{.Domain}}</h1>
      <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-slate-400 sm:text-lg">Your site is set up and live. This page is a placeholder: replace it with your own {{.Replace}} and it will be served right here.</p>
    </section>

    <section class="mx-auto mt-14 w-full max-w-3xl">
      <div class="relative rounded-2xl bg-gradient-to-b from-white/15 to-white/[0.02] p-px shadow-2xl shadow-indigo-950/60">
        <div class="rounded-[15px] bg-slate-900/80 backdrop-blur-xl">
          <div class="flex items-center gap-2 border-b border-white/5 px-4 py-3">
            <span class="h-2.5 w-2.5 rounded-full bg-rose-400/80"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-amber-300/80"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-400/80"></span>
            <span class="ml-3 truncate font-mono text-xs text-slate-500">{{.File}}</span>
          </div>
          <pre class="overflow-x-auto px-5 py-5 whitespace-pre-wrap break-words font-mono text-[13px] leading-7 text-slate-400"><span class="text-slate-600">$</span> <span class="text-indigo-300">cd</span> <span class="text-slate-200">~/htdocs/{{.Domain}}</span>
<span class="text-slate-600">$</span> <span class="text-indigo-300">ls</span>
<span class="text-emerald-300">{{.Files}}</span>
<span class="text-slate-600"># {{.Hint}}</span></pre>
        </div>
      </div>
    </section>

    <section class="mx-auto mt-14 grid w-full max-w-5xl gap-4 sm:grid-cols-3">
      <div class="group rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition duration-300 hover:-translate-y-0.5 hover:border-indigo-400/30 hover:bg-white/[0.05]">
        <span class="grid h-10 w-10 place-items-center rounded-xl bg-indigo-500/15 text-indigo-300 ring-1 ring-indigo-400/20">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4m0 0l-4 4m4-4l4 4"/><path d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2"/></svg>
        </span>
        <h2 class="mt-4 text-sm font-semibold text-white">Upload your code</h2>
        <p class="mt-1.5 text-sm leading-relaxed text-slate-400">Use the panel's file manager, SFTP, or connect a Git repository to deploy on every push.</p>
      </div>
      <div class="group rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition duration-300 hover:-translate-y-0.5 hover:border-emerald-400/30 hover:bg-white/[0.05]">
        <span class="grid h-10 w-10 place-items-center rounded-xl bg-emerald-500/15 text-emerald-300 ring-1 ring-emerald-400/20">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg>
        </span>
        <h2 class="mt-4 text-sm font-semibold text-white">Secure with SSL</h2>
        <p class="mt-1.5 text-sm leading-relaxed text-slate-400">Point the domain's DNS here and issue a free Let's Encrypt certificate in one click.</p>
      </div>
      <div class="group rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition duration-300 hover:-translate-y-0.5 hover:border-fuchsia-400/30 hover:bg-white/[0.05]">
        <span class="grid h-10 w-10 place-items-center rounded-xl bg-fuchsia-500/15 text-fuchsia-300 ring-1 ring-fuchsia-400/20">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3 8 4-16 3 8h4"/></svg>
        </span>
        <h2 class="mt-4 text-sm font-semibold text-white">Watch it run</h2>
        <p class="mt-1.5 text-sm leading-relaxed text-slate-400">{{.Watch}}</p>
      </div>
    </section>

    <footer class="mt-auto flex flex-col items-center justify-between gap-2 pt-16 text-xs text-slate-500 sm:flex-row">
      <span>Served by nginx · managed with <span class="font-medium text-slate-300">SigardaPanel</span></span>
      <span class="font-mono">{{.Domain}}</span>
    </footer>
  </main>
</body>
</html>
